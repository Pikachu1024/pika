{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "bun"],
    "baseUrl": ".",
    "paths": {
      "@pika-harness/schema": ["packages/schema/src/index.ts"],
      "@pika-harness/core": ["packages/core/src/index.ts"],
      "@pika-harness/adapters": ["packages/adapters/src/index.ts"],
      "@pika-harness/server": ["packages/server/src/index.ts"],
      "@pika-harness/client": ["packages/client/src/index.ts"],
      "@pika-harness/cli": ["apps/cli/src/index.ts"],
      "@pika-harness/pika": ["apps/pika/src/index.ts"]
    }
  }
}
