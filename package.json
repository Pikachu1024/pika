{
  "name": "pika-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:sandbox": "PIKA_REQUIRE_SANDBOX_BACKENDS=1 vitest run packages/adapters/test/sandbox",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "boundary": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm boundary && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@pika-harness/adapters": "workspace:*",
    "@pika-harness/cli": "workspace:*",
    "@pika-harness/client": "workspace:*",
    "@pika-harness/core": "workspace:*",
    "@pika-harness/schema": "workspace:*",
    "@pika-harness/server": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
