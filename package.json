{
  "name": "pika-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:binary",
    "build:js": "bun run --filter '*' build",
    "build:binary": "bun scripts/build-binaries.ts",
    "link:global": "bun run build:js && cd apps/cli && bun link && cd ../../packages/server && bun link",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:sandbox": "PIKA_REQUIRE_SANDBOX_BACKENDS=1 bun test packages/adapters/test/sandbox",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "boundary": "bun scripts/check-boundaries.mjs",
    "check": "bun run typecheck && bun run lint && bun run boundary && bun run test",
    "server": "bun packages/server/src/bin.ts",
    "cli": "bun apps/cli/src/bin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@pika-harness/adapters": "workspace:*",
    "@pika-harness/cli": "workspace:*",
    "@pika-harness/client": "workspace:*",
    "@pika-harness/core": "workspace:*",
    "@pika-harness/schema": "workspace:*",
    "@pika-harness/server": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
